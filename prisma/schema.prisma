generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Portfolio contact form submissions
enum ContactStatus {
  Pending
  Done
  Completed
  Resolved

  @@map("contact_status")
}

/// Single-admin portfolio role (Task 6)
enum AdminRole {
  Admin

  @@map("admin_role")
}

model Contact {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  subject   String
  message   String
  status    ContactStatus @default(Pending)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "contacts_created_at_idx")
  @@index([email], map: "contacts_email_idx")
  @@index([status], map: "contacts_status_idx")
  @@map("contacts")
}

/// Admin profile linked to Supabase Authentication user id (auth.users.id)
model Profile {
  id             String    @id @db.Uuid
  email          String    @unique
  name           String
  role           AdminRole @default(Admin)
  totpSecret     String?   @map("totp_secret")
  totpEnabled    Boolean   @default(false) @map("totp_enabled")
  totpVerifiedAt DateTime? @map("totp_verified_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}
