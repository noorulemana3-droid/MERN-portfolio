# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# Supabase (API / optional)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma → Supabase Postgres
# Use the Database password from Supabase → Project Settings → Database
# URL-encode special characters in the password (@ → %40, # → %23)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Google Gemini (AI Portfolio Assistant)
GEMINI_API_KEY=your-gemini-api-key

# Contact email notifications (optional Resend)
RESEND_API_KEY=your-resend-api-key
CONTACT_EMAIL_TO=nooruleman.a.3@gmail.com
CONTACT_EMAIL_FROM=Portfolio <onboarding@resend.dev>

# Admin auth (dashboard)
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=nooruleman.a.3@gmail.com
ADMIN_NAME=Noor-Ul-Eman
ADMIN_PASSWORD=Admin@12345

# Google reCAPTCHA v3 (Admin login)
# Create keys at https://www.google.com/recaptcha/admin (reCAPTCHA v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_MIN_SCORE=0.5
